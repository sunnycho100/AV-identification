{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trajectory review project v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "trajectory-review-project/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "title": {
      "type": "string"
    },
    "media_root": {
      "type": "string"
    },
    "required_duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "demo": {
      "type": "boolean"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "clip",
          "frame_data",
          "frames_template",
          "source_video_sha256",
          "frame_data_sha256"
        ],
        "properties": {
          "clip": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "frame_data": {
            "type": "string"
          },
          "frames_template": {
            "type": "string"
          },
          "video": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_video_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "frame_data_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "checkpoints": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
