{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trajectory review submission v1",
  "type": "object",
  "required": [
    "schema",
    "project_id",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "trajectory-review/v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "clip",
          "record_id",
          "reviewer",
          "source_video_sha256",
          "frame_data_sha256",
          "start_frame",
          "end_frame",
          "start_s",
          "end_s",
          "trim",
          "anchors",
          "identity_continuous",
          "decision"
        ],
        "properties": {
          "clip": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "record_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "reviewer": {
            "const": "user"
          },
          "source_video_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "frame_data_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 0
          },
          "start_s": {
            "type": "number"
          },
          "end_s": {
            "type": "number"
          },
          "trim": {
            "type": "object",
            "required": [
              "keep_start_frame",
              "keep_end_frame"
            ],
            "properties": {
              "keep_start_frame": {
                "type": "integer",
                "minimum": 0
              },
              "keep_end_frame": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "anchors": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "frame",
                "bbox",
                "source"
              ],
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "source": {
                  "enum": [
                    "manual",
                    "candidate"
                  ]
                },
                "candidate_id": {
                  "type": "string"
                }
              }
            }
          },
          "excluded_ranges": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "start_frame",
                "end_frame",
                "kind"
              ],
              "properties": {
                "start_frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "kind": {
                  "enum": [
                    "occlusion",
                    "detector_jump",
                    "identity_switch",
                    "image_freeze",
                    "timestamp_gap",
                    "small_target",
                    "other"
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 2000
                }
              }
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "enum": [
                "occlusion",
                "detector_jump",
                "identity_switch",
                "image_freeze",
                "timestamp_gap",
                "small_target",
                "other"
              ]
            }
          },
          "identity_continuous": {
            "type": "boolean"
          },
          "decision": {
            "enum": [
              "ready_for_retracking",
              "needs_followup",
              "unusable"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 10000
          }
        }
      }
    },
    "server_saved_at": {
      "type": "string"
    },
    "app_version": {
      "type": "string"
    }
  }
}
