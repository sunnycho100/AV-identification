{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "review: start SSH review server",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/START.ps1"
        ]
      },
      "args": [
        "${workspaceFolder}/server.py",
        "--workspace",
        "${workspaceFolder}/..",
        "--port",
        "8765"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
